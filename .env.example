# ================================
# Checkpoint Bot konfiguratsiyasi
# ================================

# Telegram Bot Token (@BotFather dan oling)
BOT_TOKEN=your_bot_token_here

# PostgreSQL Database URL
# Local: postgresql+asyncpg://postgres:postgres@localhost:5432/checkpoint_bot
# Docker: postgresql+asyncpg://postgres:postgres@db:5432/checkpoint_bot
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/checkpoint_bot

# Admin Telegram ID (raqam)
# @userinfobot ga /start yuboring — ID ni bilish uchun
ADMIN_TELEGRAM_ID=0

# Default checkpoint radiusi (metr)
DEFAULT_RADIUS=500

# ── Jarima tizimi ──
# Boshlanish sanasi so'raladigan va jarimalar bo'yicha mas'ul admin
FINE_ADMIN_ID=82167016
FINE_ADMIN_USERNAME=A70906
# Jarima miqdori ($), davr (kun), eslatma (muddatga necha kun qolganda)
FINE_AMOUNT=50
FINE_PERIOD_DAYS=7
FINE_WARN_DAYS=2
# Eslatma va "jarima yozildi" xabarlari (true — yoqilgan). Standart: o'chiq
FINE_NOTIFY=false
